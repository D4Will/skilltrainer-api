# Django
DJANGO_ENV=development

DEBUG=True
ALLOWED_HOSTS=127.0.0.1

# Database
POSTGRES_DB=prototype
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sevenlocal
DATABASE_URL=postgres://postgres:sevenlocal@127.0.0.1:5432/prototype

# Email (using Gmail as example)
# EMAIL_HOST=smtp.gmail.com
